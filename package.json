{
  "name": "webclone-ultimate",
  "version": "1.2.0",
  "private": true,
  "description": "Extensión de captura, grabación y reproducción local de páginas web (Chrome/Firefox, MV3)",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs --target=chrome",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "package": "node scripts/package.mjs",
    "validate:zip": "node scripts/validate-zip.mjs",
    "serve": "node scripts/serve-clone.mjs",
    "website:install": "npm --prefix website ci",
    "website:dev": "npm --prefix website run dev",
    "website:build": "npm --prefix website run build",
    "website:test": "npm --prefix website run test",
    "website:e2e": "npm --prefix website run test:e2e",
    "check": "npm run typecheck && npm test && npm run build && npm run website:test && npm run website:build"
  },
  "keywords": [
    "browser-extension",
    "web-clone",
    "web-archive",
    "rrweb",
    "manifest-v3",
    "chrome-extension",
    "firefox-addon"
  ],
  "dependencies": {
    "@rrweb/record": "^2.2.2",
    "@rrweb/replay": "^2.2.2",
    "@rrweb/types": "^2.2.2",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.28.2",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "web-ext": "^10.8.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
