{
  "manifest_version": 3,
  "name": "WebClone Ultimate",
  "short_name": "WebClone",
  "description": "Captura instantáneas y grabaciones de sesión de cualquier página web y reprodúcelas localmente.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "downloads", "unlimitedStorage", "webRequest", "cookies"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "WebClone Ultimate",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/wc-replay.js", "replay/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
